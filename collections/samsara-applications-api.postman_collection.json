            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverFleetId\": \"<string>\",\n  \"gamification\": \"<boolean>\",\n  \"gamificationConfig\": {\n    \"anonymizeDriverNames\": \"<boolean>\"\n  },\n  \"orgVehicleSearch\": \"<boolean>\",\n  \"trailerSelection\": \"<boolean>\",\n  \"trailerSelectionConfig\": {\n    \"driverTrailerCreationEnabled\": \"<boolean>\",\n    \"maxNumOfTrailersSelected\": \"<integer>\",\n    \"orgTrailerSearch\": \"<boolean>\"\n  }\n}",
