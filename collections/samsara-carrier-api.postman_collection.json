        {
          "id": "b46b0052-5fc8-4637-b44f-43170144cd33",
          "name": "Create an Assignment",
          "request": {
            "name": "Create an Assignment",
            "description": {
              "content": "Creates a new assignment that a driver can later use. Each driver can only have one future assignment. \n\n **Submit Feedback**: Likes, dislikes, and API feature requests should be filed as feedback in our <a href=\"https://forms.gle/zkD4NCH7HjKb7mm69\" target=\"_blank\">API feedback form</a>. If you encountered an issue or noticed inaccuracies in the API documentation, please <a href=\"https://www.samsara.com/help\" target=\"_blank\">submit a case</a> to our support team.\n\nTo use this endpoint, select **Write Carrier-Proposed Assignments** under the Assignments category when creating or editing an API token. <a href=\"https://developers.samsara.com/docs/authentication#scopes-for-api-tokens\" target=\"_blank\">Learn More.</a>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fleet",
                "carrier-proposed-assignments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"<string>\",\n  \"vehicleId\": \"<string>\",\n  \"activeTime\": \"<string>\",\n  \"shippingDocs\": \"<string>\",\n  \"trailerIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"trailerNames\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
