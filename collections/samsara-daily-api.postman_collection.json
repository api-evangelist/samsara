                  "disabled": false,
                  "key": "hosDate",
                  "value": "<string>",
                  "description": "(Required) A start date in yyyy-mm-dd format. Required."
                },
                {
                  "disabled": false,
                  "key": "driverID",
                  "value": "<string>",
                  "description": "(Required) ID of the driver for whom the duty status is being set."
                }
