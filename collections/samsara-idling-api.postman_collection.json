        {
          "id": "6808565a-3bc8-4ef7-a9e6-55dadd4204d1",
          "name": "Get Vehicle Idling Reports.",
          "request": {
            "name": "Get Vehicle Idling Reports.",
            "description": {
              "content": "Get all vehicle idling reports for the requested time duration.\n\n <b>Rate limit:</b> 25 requests/sec (learn more about rate limits <a href=\"https://developers.samsara.com/docs/rate-limits\" target=\"_blank\">here</a>).\n\nTo use this endpoint, select **Read Fuel & Energy** under the Fuel & Energy category when creating or editing an API token. <a href=\"https://developers.samsara.com/docs/authentication#scopes-for-api-tokens\" target=\"_blank\">Learn More.</a>\n \n\n **Submit Feedback**: Likes, dislikes, and API feature requests should be filed as feedback in our <a href=\"https://forms.gle/zkD4NCH7HjKb7mm69\" target=\"_blank\">API feedback form</a>. If you encountered an issue or noticed inaccuracies in the API documentation, please <a href=\"https://www.samsara.com/help\" target=\"_blank\">submit a case</a> to our support team.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fleet",
                "reports",
                "vehicle",
                "idling"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": " If specified, this should be the endCursor value from the previous page of results. When present, this request will return the next page of results that occur immediately after the previous page of results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "512",
                  "description": "The limit for how many objects will be in the response. Default and max for this value is 512 objects."
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<string>",
                  "description": "(Required)  A start time in RFC 3339 format. Defaults to now if not provided. Millisecond precision and timezones are supported. Note that the most recent 72 hours of data may still be processing and is subject to change and latency, so it is not recommended to request data for the most recent 72 hours. (Examples: 2019-06-13T19:08:25Z, 2019-06-13T19:08:25.455Z, OR 2015-09-15T14:00:12-04:00)."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<string>",
                  "description": "(Required)  An end time in RFC 3339 format. Defaults to now if not provided. Millisecond precision and timezones are supported. Note that the most recent 72 hours of data may still be processing and is subject to change and latency, so it is not recommended to request data for the most recent 72 hours. (Examples: 2019-06-13T19:08:25Z, 2019-06-13T19:08:25.455Z, OR 2015-09-15T14:00:12-04:00)."
                },
                {
                  "disabled": false,
                  "key": "vehicleIds",
                  "value": "<string>",
                  "description": " A filter on the data based on this comma-separated list of vehicle IDs and externalIds. Example: `vehicleIds=1234,5678,samsara.vin:1HGBH41JXMN109186`"
                },
                {
                  "disabled": false,
                  "key": "tagIds",
                  "value": "<string>",
                  "description": " A filter on the data based on this comma-separated list of tag IDs. Example: `tagIds=1234,5678`"
                },
                {
                  "disabled": false,
                  "key": "parentTagIds",
                  "value": "<string>",
                  "description": " A filter on the data based on this comma-separated list of parent tag IDs, for use by orgs with tag hierarchies. Specifying a parent tag will implicitly include all descendent tags of the parent tag. Example: `parentTagIds=345,678`"
                },
                {
                  "disabled": false,
                  "key": "isPtoActive",
                  "value": "<boolean>",
                  "description": "A filter on the data based on power take-off being active or inactive."
                },
                {
                  "disabled": false,
                  "key": "minIdlingDurationMinutes",
                  "value": "<integer>",
                  "description": "A filter on the data based on a minimum idling duration."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
