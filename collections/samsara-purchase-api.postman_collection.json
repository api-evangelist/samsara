                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fuelQuantityLiters\": \"<string>\",\n  \"transactionLocation\": \"<string>\",\n  \"transactionPrice\": {\n    \"amount\": \"<string>\",\n    \"currency\": \"<string>\"\n  },\n  \"transactionReference\": \"<string>\",\n  \"transactionTime\": \"<string>\",\n  \"iftaFuelType\": \"<string>\",\n  \"vehicleId\": \"<string>\"\n}",
